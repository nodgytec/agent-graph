# Copy this file to .env and fill in your Anthropic API key.
# Leave it empty to use offline stubs. Restart the script after editing.
ANTHROPIC_API_KEY=

# Required for an API key that is not scoped to an Anthropic workspace.
# Copy the wrkspc_... ID from Claude Console > Settings > Workspaces.
# This is separate from the local codebase folder selected with /workspace.
ANTHROPIC_WORKSPACE_ID=

# Optional staff reviewer model override:
# ANTHROPIC_REVIEW_MODEL=claude-fable-5-1
